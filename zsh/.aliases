alias ls="eza"
alias ll="eza -la"

# nvr talks to a running Neovim server. Skip the aliases when the host has
# no nvr, so the shell does not shadow a working nvim.
if command -v nvr >/dev/null 2>&1; then
  alias nvr="nvr --servername $NVR_SERVER"
  alias nvrt="nvr --remote-tab"
fi

# ssh goes through the kitty kitten. A host in VAULT_SYNC_HOSTS also gets
# a Mutagen copy of the vault, and the remote shell points nvim at it.
if command -v kitty >/dev/null 2>&1; then
  ssh() {
    local host
    host=$(command ssh -G "$@" 2>/dev/null | awk '$1 == "host" { print $2; exit }')
    if [[ -n $host ]] && vault-sync enabled "$host" 2>/dev/null; then
      vault-sync up "$host" || print -u2 "vault-sync failed. Connecting anyway."
      kitty +kitten ssh \
        --kitten "env=OBSIDIAN_VAULT_ROOT=\$HOME/$(vault-sync remote-dir)" "$@"
    else
      kitty +kitten ssh "$@"
    fi
  }
fi
