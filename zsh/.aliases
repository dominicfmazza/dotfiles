alias ls="eza"
alias ll="eza -la"

# nvr reads $NVIM, so it finds the parent Neovim from a terminal buffer.
if command -v nvr >/dev/null 2>&1; then
  alias nvrt="nvr --remote-tab"
fi

# A host in OOB_HOSTS gets an oob channel. A host in VAULT_SYNC_HOSTS gets
# a copy of the vault. kitty adds its kitten when this shell runs in kitty.
ssh() {
  local host
  local -a kitten
  host=$(command ssh -G "$@" 2>/dev/null | awk '$1 == "host" { print $2; exit }')
  if [[ -n $host ]] && oob enabled "$host" 2>/dev/null; then
    oob up "$host" || print -u2 "oob up failed. Connecting anyway."
  fi
  if [[ -n $host ]] && vault-sync enabled "$host" 2>/dev/null; then
    vault-sync up "$host" || print -u2 "vault-sync failed. Connecting anyway."
    kitten=(--kitten "env=OBSIDIAN_VAULT_ROOT=\$HOME/$(vault-sync remote-dir)")
  fi
  if [[ $TERM == xterm-kitty ]] && (( $+commands[kitty] )); then
    kitty +kitten ssh "${kitten[@]}" "$@"
  else
    command ssh "$@"
  fi
}
