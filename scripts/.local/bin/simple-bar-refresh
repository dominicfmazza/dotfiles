#!/bin/bash
# simple-bar-refresh: tell Übersicht to redraw the simple-bar widget.
#
# AeroSpace calls this from on-focus-changed and exec-on-workspace-change.
#
# The obvious way to redraw is osascript:
#
#   osascript -e 'tell application id "tracesOf.Uebersicht" to refresh widget id ...'
#
# That costs about 0.19 s, and almost all of it is osascript startup. A bare
# `osascript -e 'return 1'` already costs 0.06 s. A workspace switch fires both
# hooks, so the old config paid that cost twice and the space icons lagged.
#
# This script skips osascript. Übersicht runs a local HTTP server with a
# websocket message bus, and the bus broadcasts any client message to every
# client. The web client acts on a WIDGET_WANTS_REFRESH message: it calls
# forceRefresh() on the named widget. That is the same code path the AppleScript
# command ends in.
#
# bash speaks TCP through /dev/tcp, so the exchange needs no child process.
# Cost: about 0.01 s, which is 20 times faster than osascript. At that speed a
# double call needs no lock and no coalescing.
#
# The script needs bash for /dev/tcp. POSIX sh has no such feature.

set -u

PORT=${UEBERSICHT_PORT:-41416}
HOST=127.0.0.1

# The widgets to redraw, separated by whitespace. simple-bar is the only one
# today. The loop below sends one frame per id over a single connection, so a
# second widget costs one more frame and no extra process.
WIDGET_IDS=${SIMPLE_BAR_WIDGET_IDS:-simple-bar-index-jsx}

# osascript is the fallback. It is slow, but it always works. A change in the
# Übersicht internals then costs speed and never breaks the redraw.
fallback() {
  for _id in $WIDGET_IDS; do
    /usr/bin/osascript -e \
      "tell application id \"tracesOf.Uebersicht\" to refresh widget id \"$_id\"" \
      >/dev/null 2>&1
  done
}

close_socket() {
  exec 3<&-
  exec 3>&-
}

# The server checks the Host header and the Origin header. It wants an exact
# match on "http://<host>:<port>". A wrong Origin gets a 401.
#
# A redirect on exec cannot be guarded with ||. bash reports the failure itself
# and the || never runs, so the message leaks to stderr and the fallback never
# happens. Test the connection in a subshell first, where a failure is contained.
if ! (exec 3<>"/dev/tcp/$HOST/$PORT") 2>/dev/null; then
  fallback
  exit $?
fi

exec 3<>"/dev/tcp/$HOST/$PORT" 2>/dev/null || {
  fallback
  exit $?
}

{
  printf 'GET / HTTP/1.1\r\n'
  printf 'Host: %s:%s\r\n' "$HOST" "$PORT"
  printf 'Upgrade: websocket\r\n'
  printf 'Connection: Upgrade\r\n'
  printf 'Sec-WebSocket-Version: 13\r\n'
  printf 'Sec-WebSocket-Key: AAAAAAAAAAAAAAAAAAAAAA==\r\n'
  printf 'Origin: http://%s:%s\r\n' "$HOST" "$PORT"
  printf '\r\n'
} >&3

# Read the handshake reply. Stop at the blank line that ends the headers.
status=''
while IFS= read -r -t 2 line <&3; do
  [ "$line" = $'\r' ] && break
  case $line in
  HTTP/*) status=$line ;;
  esac
done

case $status in
*101*) ;;
*)
  close_socket
  fallback
  exit $?
  ;;
esac

# Write one websocket text frame per widget id, all on this connection.
#   0x81         FIN bit plus opcode 1 (text)
#   0x80 | len   mask bit plus the payload length
#   4 zero bytes the mask key
# A zero mask key leaves the payload as plain text. The spec allows any key, and
# the server unmasks it either way. Every payload stays near 60 bytes, well under
# the 126-byte limit that needs a longer length field.
for id in $WIDGET_IDS; do
  payload="{\"type\":\"WIDGET_WANTS_REFRESH\",\"payload\":\"$id\"}"
  len=${#payload}

  if [ "$len" -ge 126 ]; then
    close_socket
    fallback
    exit $?
  fi

  {
    printf '\x81'
    printf "\\x$(printf '%02x' $((0x80 | len)))"
    printf '\x00\x00\x00\x00'
    printf '%s' "$payload"
  } >&3
done

# Closing the socket right after the last write truncates it. bash returns from a
# write as soon as the bytes reach the kernel buffer, and the close then tears the
# connection down before the server reads them all. Measured: with two ids and no
# wait, only the first frame arrives. A short sleep lets the server drain.
sleep "${SIMPLE_BAR_REFRESH_FLUSH:-0.05}"

close_socket
exit 0
