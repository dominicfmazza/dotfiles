{
  "_comment": "Custom pi providers. bootstrap.sh seeds this file and never overwrites it. Keep the API key as an environment reference, never a literal. Delete the example provider on a personal host.",
  "providers": {
    "exampleProxy": {
      "baseUrl": "$PI_PROXY_BASE_URL",
      "apiKey": "$PI_PROXY_API_KEY",
      "api": "openai-completions",
      "models": [
        {
          "id": "example-model-id",
          "name": "Example Model",
          "reasoning": false,
          "input": ["text", "image"],
          "cost": { "input": 1, "output": 5, "cacheRead": 0.1, "cacheWrite": 1.25 },
          "contextWindow": 200000,
          "maxTokens": 8192,
          "compat": { "cacheControlFormat": "anthropic" }
        }
      ]
    }
  }
}
